rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // TEMPORARY: Firebase test-mode rule, open to any client until 2026-10-22.
    // Replace with default-deny rules before then
    // (portal/docs/06-phase0-admin-lockdown.md).
    //
    // Server-only collections are excluded, so no client can read or write
    // them. The admin server reads them with firebase-admin, which bypasses
    // these rules:
    //   guestPassportData: passport-form data for /reports/customers
    match /{collection}/{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 10, 22)
        && !(collection in ['guestPassportData']);
    }
  }
}
